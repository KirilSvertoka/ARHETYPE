# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public HTTPS origin of the shop (canonical, OG, sitemap, feeds).
# On production set exactly: https://archetype.by
# Used when the app runs behind a reverse proxy that may report http.
APP_URL="https://archetype.by"

# Telegram Bot Token for callback notifications
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Telegram Chat ID to receive notifications
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# Admin credentials for the dashboard
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="password123"

# Secret URL path for the admin dashboard (e.g., "/super-secret-admin")
# Leaving this blank will default to "/admin"
VITE_ADMIN_PATH="/admin"

# YooKassa Shop ID for processing payments
YOOKASSA_SHOP_ID="your_shop_id"

# YooKassa Secret Key for processing payments
YOOKASSA_SECRET_KEY="test_..."
